# Copier ce fichier en `.env` et renseigner les vraies valeurs.
NODE_ENV=development
PORT=4000

# Connexion PostgreSQL (PostgreSQL 18 local). Remplacer MOT_DE_PASSE.
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/csi_cnam?schema=public"

# Sécurité (BNF1) : en production, utiliser deux secrets aléatoires distincts
# d'au moins 32 caractères. Exemple de génération : `openssl rand -base64 48`.
JWT_SECRET="dev-jwt-secret-a-remplacer-uniquement-en-production"
JWT_EXPIRES_IN="2h"
# Durée maximale du cookie HttpOnly de session (doit rester cohérente avec JWT_EXPIRES_IN)
SESSION_COOKIE_MAX_AGE_SECONDS=7200
MAX_LOGIN_ATTEMPTS=5
# Durée de validité d'un mot de passe initial/réinitialisé (1 à 168 heures)
TEMP_PASSWORD_EXPIRES_HOURS=24
SHUTDOWN_TIMEOUT_SECONDS=15
# Identifiant de version affiché par /api/health et /api/ready (commit Git, tag, etc.).
RELEASE_SHA="local"
# Clé de chiffrement des données sensibles (coordonnées bancaires — BNF1)
ENCRYPTION_KEY="dev-encryption-key-change-me-please"
# Chemin de pg_dump si absent du PATH (sauvegardes — BNF3)
# PG_DUMP_PATH="C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe"
# PG_RESTORE_PATH="C:\\Program Files\\PostgreSQL\\18\\bin\\pg_restore.exe"
# BACKUP_DIR="D:\\Sauvegardes\\csi-cnam"
BACKUP_RETENTION_DAYS=30

# CORS : origine(s) du front (plusieurs possibles, séparées par des virgules)
CORS_ORIGIN="http://localhost:5173"
# Plafond du rate-limit global par IP / 15 min (BNF2)
RATE_LIMIT_MAX=600
